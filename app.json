{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.vmercel.trademuse"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.vmercel.trademuse",
      "supportsTablet": true
    },
    "name": "TradeMuse",
    "newArchEnabled": true,
    "orientation": "portrait",
    "plugins": [
      "expo-router"
    ],
    "scheme": "trademuse",
    "slug": "trademuse",
    "splash": {
      "backgroundColor": "#0B0E14",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "userInterfaceStyle": "dark",
    "version": "0.1.0",
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}